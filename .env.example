# Copy this file to .env and fill in your key. .env is git-ignored.
# The code reads OPENROUTER_API_KEY from the environment, NEVER from a notebook or repo file.

OPENROUTER_API_KEY=
# Set USE_MOCK=1 to force offline mode even if a key is present (safe default for demos).
USE_MOCK=1
# Model used when calling the API (OpenRouter model id, e.g. openai/gpt-4o-mini).
MODEL=openai/gpt-4o-mini
